# Git Repository Configuration
# Required: The git repository URL to sync from
GIT_REPO_URL=https://github.com/your-org/your-knowledge-base.git

# Branch to sync (default: main)
GIT_BRANCH=main

# Subdirectory within the repo containing markdown files (optional)
# Leave empty or set to "." for root
DOCS_SUBPATH=docs

# Sync Configuration
# How often git-sync pulls from remote (default: 60s)
SYNC_PERIOD=60s

# How often basic-memory re-indexes documents (default: 300s / 5 min)
MEMORY_SYNC_PERIOD=300

# Set to "true" to sync once and exit (useful for testing)
ONE_TIME_SYNC=false

# MCP Server Configuration
# Port for the basic-memory SSE server
MCP_PORT=8765

# Private Repository Configuration (optional)
# Uncomment and set path to SSH key for private repos
# SSH_KEY_PATH=~/.ssh/id_rsa
