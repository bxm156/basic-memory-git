// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "basic-memory-git dev",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:3.13-trixie",
  "features": {
    // Ansible and ansible-lint now managed by mise (see .mise.toml and requirements.txt)
    "ghcr.io/atty303/devcontainer-features/mise:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": "false",
      "dockerComposeVersion": "v2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "Catppuccin.catppuccin-vsc",
        "thang-nm.catppuccin-perfect-icons"
      ]
    }
  }
  // DoD can access host, wouldn't need to waste ips "runArgs": ["--add-host=host.docker.internal:host-gateway"]

  //"workspaceFolder": "/workspace",
  //"mounts": [
  //	"source=zfs_engineering_data,target=/workspace,type=volume"
  //],
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  // Dependencies managed by mise - see .mise.toml for installation hooks

  // Configure tool-specific properties.
  // "customizations": {},
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
